<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_pill_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_pill_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_mini_surface_placeholder"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/widget_pill_art"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/widget_mini_art_frame"
            android:clipToOutline="true"
            android:contentDescription="@string/widget_artwork"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_preview_art" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_pill_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/sf_pro_display_semibold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:text="@string/widget_preview_title"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_pill_previous"
                    android:layout_width="50dp"
                    android:layout_height="36dp"
                    android:background="@drawable/widget_transport_button"
                    android:contentDescription="@string/widget_previous"
                    android:padding="9dp"
                    android:src="@drawable/ic_widget_previous" />

                <ImageView
                    android:id="@+id/widget_pill_toggle"
                    android:layout_width="50dp"
                    android:layout_height="36dp"
                    android:background="@drawable/widget_transport_button"
                    android:contentDescription="@string/widget_play"
                    android:padding="8dp"
                    android:src="@drawable/ic_widget_play" />

                <ImageView
                    android:id="@+id/widget_pill_next"
                    android:layout_width="50dp"
                    android:layout_height="36dp"
                    android:background="@drawable/widget_transport_button"
                    android:contentDescription="@string/widget_next"
                    android:padding="9dp"
                    android:src="@drawable/ic_widget_next" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
