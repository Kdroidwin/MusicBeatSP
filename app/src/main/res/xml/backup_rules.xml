<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!--
        These preference files contain account cookies, API tokens, source
        credentials, and scrobbler secrets. The app's explicit JSON backup
        already omits credentials; Android's automatic backup must do the same.
    -->
    <exclude domain="sharedpref" path="bitchord_settings.xml" />
    <exclude domain="sharedpref" path="bitchord_auth.xml" />
    <exclude domain="sharedpref" path="bitchord_auth_plain.xml" />
    <exclude domain="sharedpref" path="bitchord_sources.xml" />
    <exclude domain="sharedpref" path="bitchord_sources_plain.xml" />
    <exclude domain="sharedpref" path="music_server_credentials_encrypted.xml" />
    <!-- Downloaded executable extension code is reinstalled from its HTTPS registry. -->
    <exclude domain="file" path="lyrics_extensions/" />
    <!-- WebView may persist Google/Spotify session cookies under app_webview. -->
    <exclude domain="root" path="app_webview/" />
</full-backup-content>
